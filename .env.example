# Ключи генератора. Свои имена с префиксом BUILDER_ — не путать с остальным окружением.
# Значения не покидают машину; сайдкар слушает 127.0.0.1.
#
# Вписывать их руками не нужно: ключ, вставленный в сайдбар («+ своя»),
# попадает сюда сам (имя = BUILDER_<id подключения>_KEY), а settings.json
# хранит только имя переменной. Ниже — те, что уже заведены на этом компе.
BUILDER_OPENROUTER_KEY=
BUILDER_LITELLM_KEY=
BUILDER_IMAGENING_KEY=
